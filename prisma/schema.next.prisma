generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  sessionVersion Int @default(0)
  userRoles UserRole[]
}

model Role {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  userRoles UserRole[]
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  name  String
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])
  @@unique([userId, roleId])
}

enum RoomStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  INTERNAL_USE
}

enum RoomType {
  NORMAL
  AIR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DocumentStatus {
  DRAFT
  SENT
  CANCELED
}

enum BillingStatus {
  PENDING
  OVERDUE
  TERMINATED
  PAID
}

enum MessageSender {
  ADMIN
  RESIDENT
}

model Floor {
  id    String @id @default(cuid())
  idx   Int
  name  String
  rooms Room[]
  tenantId String?

  @@unique([idx])
}

model Room {
  number    String     @id
  floorId   String
  floor     Floor      @relation(fields: [floorId], references: [id])
  status    RoomStatus @default(VACANT)
  type      RoomType   @default(NORMAL)
  contracts Contract[]
  histories MoveHistory[]
  occupants RoomResident[]
  billing   BillingRecord[]
  tickets   Ticket[]
  documents DocumentVersion[]
  conversations Conversation[]
  tenantId String?
}

model Resident {
  id          String       @id @default(cuid())
  fullName    String
  lineBinding LineBinding?
  contracts   Contract[]   @relation("ContractResidents")
  primaryContracts Contract[] @relation("ContractPrimary")
  events      MoveHistory[]
  tickets     Ticket[]
  lineMessages LineMessage[]
  conversations Conversation[]
  roomResidencies RoomResident[]
  tenantId String?
}

model LineBinding {
  id         String   @id @default(cuid())
  lineUserId String   @unique
  residentId String   @unique
  resident   Resident @relation(fields: [residentId], references: [id])
  approved   Boolean  @default(false)
  approvedAt DateTime?
  tenantId String?
}

model Contract {
  id                 String     @id @default(cuid())
  roomNumber         String
  room               Room       @relation(fields: [roomNumber], references: [number])
  primaryResidentId  String
  primaryResident    Resident   @relation("ContractPrimary", fields: [primaryResidentId], references: [id])
  residents          Resident[] @relation("ContractResidents")
  startDate          DateTime
  endDate            DateTime?
  active             Boolean    @default(true)
  tenantId String?
}

model MoveHistory {
  id         String   @id @default(cuid())
  roomNumber String
  room       Room     @relation(fields: [roomNumber], references: [number])
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id])
  type       String
  at         DateTime  @default(now())
  tenantId String?
}

model BillingMonth {
  id      String @id @default(cuid())
  year    Int
  month   Int
  closed  Boolean @default(false)
  dueDay  Int     @default(7)
  records BillingRecord[]
  docVersions DocumentVersion[]
  tenantId String?

  @@unique([year, month], name: "year_month")
}

model BillingRecord {
  id            String       @id @default(cuid())
  roomNumber    String
  room          Room         @relation(fields: [roomNumber], references: [number])
  billingMonthId String
  billingMonth  BillingMonth @relation(fields: [billingMonthId], references: [id])
  amount        Decimal      @db.Decimal(12,2)
  adjustments   Decimal      @db.Decimal(12,2) @default(0)
  note          String?
  raw           Json?
  dueDate       DateTime?
  overdueDays   Int          @default(0)
  penalty       Decimal      @db.Decimal(12,2) @default(0)
  status        BillingStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payments      PaymentMatch[]
  auditLogs     AuditLog[]
  tenantId String?

  @@unique([roomNumber, billingMonthId], name: "roomNumber_billingMonthId")
}

model DocumentTemplate {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  content Bytes
  createdAt DateTime @default(now())
  versions DocumentVersion[]
  tenantId String?
}

model DocumentVersion {
  id             String         @id @default(cuid())
  templateId     String
  template       DocumentTemplate @relation(fields: [templateId], references: [id])
  roomNumber     String
  room           Room           @relation(fields: [roomNumber], references: [number])
  billingMonthId String?
  billingMonth   BillingMonth?  @relation(fields: [billingMonthId], references: [id])
  versionNo      Int
  status         DocumentStatus @default(DRAFT)
  generatedAt    DateTime       @default(now())
  file           Bytes
  sendLogs       DocumentSendLog[]
  tenantId String?

  @@unique([templateId, roomNumber, billingMonthId, versionNo])
}

model DocumentSendLog {
  id               String          @id @default(cuid())
  documentVersionId String
  documentVersion  DocumentVersion @relation(fields: [documentVersionId], references: [id])
  channel          String
  delivered        Boolean @default(false)
  createdAt        DateTime @default(now())
  tenantId String?
}

model Payment {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12,2)
  bankRef    String?
  occurredAt DateTime
  matched    Boolean  @default(false)
  matches    PaymentMatch[]
  tenantId String?
}

model PaymentMatch {
  id             String        @id @default(cuid())
  paymentId      String
  payment        Payment       @relation(fields: [paymentId], references: [id])
  billingRecordId String
  billingRecord  BillingRecord @relation(fields: [billingRecordId], references: [id])
  matchedAmount  Decimal       @db.Decimal(12,2)
  confirmed      Boolean       @default(false)
  confirmedAt    DateTime?
  tenantId String?
}

model Ticket {
  id         String       @id @default(cuid())
  roomNumber String
  room       Room         @relation(fields: [roomNumber], references: [number])
  residentId String?
  resident   Resident?    @relation(fields: [residentId], references: [id])
  status     TicketStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  messages   TicketMessage[]
  tenantId String?
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id])
  sender    MessageSender
  text      String
  createdAt DateTime      @default(now())
  tenantId String?
}

model LineMessage {
  id         String        @id @default(cuid())
  residentId String?
  resident   Resident?     @relation(fields: [residentId], references: [id])
  sender     MessageSender
  text       String
  createdAt  DateTime      @default(now())
  tenantId String?
}

model RoomResident {
  id         String   @id @default(cuid())
  roomNumber String
  room       Room     @relation(fields: [roomNumber], references: [number])
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])
  role       String   @default("SECONDARY") // PRIMARY or SECONDARY
  active     Boolean  @default(true)
  startDate  DateTime @default(now())
  endDate    DateTime?
  tenantId String?

  @@index([roomNumber])
  @@index([residentId])
}

model Conversation {
  id          String    @id @default(cuid())
  residentId  String?
  resident    Resident? @relation(fields: [residentId], references: [id])
  roomNumber  String?
  room        Room?     @relation(fields: [roomNumber], references: [number])
  unreadCount Int       @default(0)
  createdAt   DateTime  @default(now())
  messages    ConversationMessage[]
  tenantId String?

  @@index([roomNumber])
  @@index([residentId])
}

model ConversationMessage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  sender         MessageSender
  text           String
  createdAt      DateTime      @default(now())
  billingRecordId String?
  ticketId        String?
  tenantId String?
}

model BillingFieldMapping {
  id        String  @id @default(cuid())
  sourceKey String
  targetKey String
  active    Boolean @default(true)
  tenantId String?
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  data       Json?
  createdAt  DateTime @default(now())
  billingRecordId String?
  billingRecord   BillingRecord? @relation(fields: [billingRecordId], references: [id])
  tenantId String?
}

