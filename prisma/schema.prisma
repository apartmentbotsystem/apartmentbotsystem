generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  passwordHash String?
  sessionVersion Int   @default(0)
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  createdAt DateTime   @default(now())
  userRoles UserRole[]
}

model Role {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  userRoles UserRole[]
}

model Permission {
  id   String @id @default(cuid())
  code String @unique
  name String
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

enum RoomStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  SELF_USE
}

enum RoomType {
  NORMAL
  AIR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DocumentStatus {
  DRAFT
  READY
  SENT
  FAILED
  CANCELED
}

enum BillingStatus {
  PENDING
  OVERDUE
  TERMINATED
  PAID
}

enum MessageSender {
  ADMIN
  RESIDENT
}

model Floor {
  id       String  @id @default(cuid())
  idx      Int
  name     String
  rooms    Room[]
  tenantId String?

  @@unique([idx])
}

model Room {
  id            String            @unique @default(cuid())
  number        String            @id
  roomNumber    String?           @unique
  floorId       String
  floor         Floor             @relation(fields: [floorId], references: [id])
  buildingId    String?
  building      Building?         @relation(fields: [buildingId], references: [id])
  capacity      Int               @default(2)
  status        RoomStatus        @default(VACANT)
  type          RoomType          @default(NORMAL)
  createdAt     DateTime          @default(now())
  contracts     Contract[]
  histories     MoveHistory[]
  occupants     RoomResident[]
  billing       BillingRecord[]
  billingVersions BillingVersion[]
  tickets       Ticket[]
  documents     DocumentVersion[]
  conversations Conversation[]
  tenantId      String?
}

model Building {
  id    String @id @default(cuid())
  name  String @unique
  rooms Room[]
}

model Resident {
  id               String         @id @default(cuid())
  fullName         String
  contracts        Contract[]     @relation("ContractResidents")
  primaryContracts Contract[]     @relation("ContractPrimary")
  events           MoveHistory[]
  tickets          Ticket[]
  lineMessages     LineMessage[]
  conversations    Conversation[]
  roomResidencies  RoomResident[]
  tenantId         String?
}

model LineBinding {
  id         String   @id @default(cuid())
  lineUserId String   @unique
  roomNumber String
  createdAt  DateTime @default(now())

  @@index([roomNumber])
}

// removed duplicate LineRoomBinding

model Contract {
  id                String     @id @default(cuid())
  roomNumber        String
  room              Room       @relation(fields: [roomNumber], references: [number])
  primaryResidentId String
  primaryResident   Resident   @relation("ContractPrimary", fields: [primaryResidentId], references: [id])
  residents         Resident[] @relation("ContractResidents")
  startDate         DateTime
  endDate           DateTime?
  active            Boolean    @default(true)
  tenantId          String?
}

model MoveHistory {
  id         String    @id @default(cuid())
  roomNumber String
  room       Room      @relation(fields: [roomNumber], references: [number])
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id])
  type       String
  at         DateTime  @default(now())
  tenantId   String?
}

model BillingMonth {
  id          String            @id @default(cuid())
  year        Int
  month       Int
  label       String            @default("")
  consumptionYear Int           @default(0)
  consumptionMonth Int          @default(0)
  closed      Boolean           @default(false)
  locked      Boolean           @default(false)
  lockedAt    DateTime?
  lockedBy    String?
  dueDay      Int               @default(7)
  records     BillingRecord[]
  versions    BillingVersion[]
  docVersions DocumentVersion[]
  tenantId    String?

  @@unique([year, month], name: "year_month")
}

model BillingRecord {
  id             String         @id @default(cuid())
  roomNumber     String
  room           Room           @relation(fields: [roomNumber], references: [number])
  billingMonthId String
  billingMonth   BillingMonth   @relation(fields: [billingMonthId], references: [id])
  rent           Decimal        @default(0) @db.Decimal(12, 2)
  water          Decimal        @default(0) @db.Decimal(12, 2)
  electric       Decimal        @default(0) @db.Decimal(12, 2)
  other          Decimal        @default(0) @db.Decimal(12, 2)
  amount         Decimal        @db.Decimal(12, 2)
  adjustments    Decimal        @default(0) @db.Decimal(12, 2)
  note           String?
  raw            Json?
  dueDate        DateTime?
  overdueDays    Int            @default(0)
  penalty        Decimal        @default(0) @db.Decimal(12, 2)
  status         BillingStatus  @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  payments       PaymentMatch[]
  auditLogs      AuditLog[]
  tenantId       String?

  @@unique([roomNumber, billingMonthId], name: "roomNumber_billingMonthId")
}

model BillingVersion {
  id             String   @id @default(cuid())
  roomId         String?
  roomNumber     String
  room           Room     @relation(fields: [roomNumber], references: [number], onDelete: Cascade)
  billingMonthId String
  billingMonth   BillingMonth @relation(fields: [billingMonthId], references: [id], onDelete: Cascade)
  versionNo      Int
  snapshotData   Json
  totalAmount    Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  revertedFromId String?
  revertedFrom   BillingVersion? @relation("RevertChain", fields: [revertedFromId], references: [id])
  revertedTo     BillingVersion[] @relation("RevertChain")
  createdAt      DateTime @default(now())
  createdBy      String
  tenantId       String?
  documents      DocumentVersion[]

  @@unique([roomNumber, billingMonthId, versionNo])
  @@index([roomNumber, billingMonthId])
  @@index([roomNumber, billingMonthId, isActive])
  @@index([billingMonthId, roomId, isActive])
  @@index([isActive])
}

model FinancialFlag {
  id             String   @id @default(cuid())
  roomNumber     String
  billingMonthId String
  type           String
  difference     Decimal  @db.Decimal(12, 2)
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())
  tenantId       String?
}

model DocumentTemplate {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  content   Bytes
  createdAt DateTime          @default(now())
  versions  DocumentVersion[]
  tenantId  String?
}

model DocumentVersion {
  id              String            @id @default(cuid())
  templateId      String
  template        DocumentTemplate  @relation(fields: [templateId], references: [id])
  roomId          String?
  roomNumber      String
  room            Room              @relation(fields: [roomNumber], references: [number])
  billingMonthId  String?
  billingMonth    BillingMonth?     @relation(fields: [billingMonthId], references: [id])
  billingVersionId String?
  billingVersion   BillingVersion?   @relation(fields: [billingVersionId], references: [id], onDelete: SetNull)
  versionNo       Int
  status          DocumentStatus    @default(DRAFT)
  generatedAt     DateTime          @default(now())
  file            Bytes
  hash            String
  sendLogs        DocumentSendLog[]
  deliveryLogs    DeliveryLog[]
  tenantId        String?
  // Template Engine extensions
  templateGroupId String?
  templateVersion Int?
  snapshotJson    Json?
  isZeroAmount    Boolean           @default(false)

  @@unique([templateId, roomNumber, billingMonthId, versionNo])
  @@unique([roomNumber, billingMonthId, templateGroupId])
  @@index([billingVersionId])
}

model DocumentSendLog {
  id                String          @id @default(cuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])
  channel           String
  delivered         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  tenantId          String?
}

enum DeliveryChannel {
  LINE
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model DeliveryLog {
  id                String           @id @default(cuid())
  documentVersionId String
  channel           DeliveryChannel
  status            DeliveryStatus
  lineMessageId     String?
  errorMessage      String?
  sentBy            String?
  createdAt         DateTime         @default(now())

  documentVersion   DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([documentVersionId])
}

model Payment {
  id         String         @id @default(cuid())
  roomId     String?
  paidAt     DateTime?
  matchedBillingVersionId String?
  amount     Decimal        @db.Decimal(12, 2)
  method     String?
  status     String?
  confidenceScore Decimal?  @db.Decimal(5, 2)
  confirmedBy String?
  confirmedAt DateTime?
  bankRef    String?
  occurredAt DateTime
  matched    Boolean        @default(false)
  matches    PaymentMatch[]
  tenantId   String?
}

model PaymentMatch {
  id              String        @id @default(cuid())
  paymentId       String
  payment         Payment       @relation(fields: [paymentId], references: [id])
  billingRecordId String
  billingRecord   BillingRecord @relation(fields: [billingRecordId], references: [id])
  matchedAmount   Decimal       @db.Decimal(12, 2)
  confirmed       Boolean       @default(false)
  confirmedAt     DateTime?
  tenantId        String?
}

model Ticket {
  id         String          @id @default(cuid())
  roomId     String?
  roomNumber String
  room       Room            @relation(fields: [roomNumber], references: [number])
  title      String          @default("")
  residentId String?
  resident   Resident?       @relation(fields: [residentId], references: [id])
  status     TicketStatus    @default(OPEN)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  messages   TicketMessage[]
  tenantId   String?
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id])
  sender    MessageSender
  text      String
  createdAt DateTime      @default(now())
  tenantId  String?
}

model LineMessage {
  id         String        @id @default(cuid())
  residentId String?
  resident   Resident?     @relation(fields: [residentId], references: [id])
  sender     MessageSender
  text       String
  createdAt  DateTime      @default(now())
  tenantId   String?
}

model RoomResident {
  id         String    @id @default(cuid())
  roomNumber String
  room       Room      @relation(fields: [roomNumber], references: [number])
  residentId String
  resident   Resident  @relation(fields: [residentId], references: [id])
  role       String    @default("SECONDARY") // PRIMARY or SECONDARY
  active     Boolean   @default(true)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  tenantId   String?

  @@index([roomNumber])
  @@index([residentId])
}

model Conversation {
  id          String                @id @default(cuid())
  residentId  String?
  resident    Resident?             @relation(fields: [residentId], references: [id])
  roomNumber  String?
  room        Room?                 @relation(fields: [roomNumber], references: [number])
  unreadCount Int                   @default(0)
  lineUserId  String?               @unique
  lastMessageAt DateTime            @default(now())
  unreadAdmin Int                   @default(0)
  createdAt   DateTime              @default(now())
  messages    ConversationMessage[]
  tenantId    String?

  @@index([roomNumber])
  @@index([residentId])
}

model ConversationMessage {
  id              String        @id @default(cuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id])
  sender          MessageSender
  text            String
  createdAt       DateTime      @default(now())
  billingRecordId String?
  ticketId        String?
  tenantId        String?
}

model Chat {
  id                   String   @id @default(uuid())
  conversation_id      String
  sender               String
  text                 String
  created_at           DateTime @default(now())
  external_message_id  String?  @unique

  @@index([conversation_id])
  @@index([created_at(sort: Desc)])
  @@map("chat")
}

model BillingFieldMapping {
  id        String  @id @default(cuid())
  sourceKey String
  targetKey String
  active    Boolean @default(true)
  tenantId  String?
}

model AuditLog {
  id              String         @id @default(cuid())
  action          String
  entityType      String
  entityId        String
  data            Json?
  createdAt       DateTime       @default(now())
  billingRecordId String?
  billingRecord   BillingRecord? @relation(fields: [billingRecordId], references: [id])
  tenantId        String?
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String
  route     String
  hash      String
  response  Json
  createdAt DateTime @default(now())

  @@unique([key, route])
}

model SystemSnapshot {
  id          String   @id @default(uuid())
  snapshotKey String   @unique
  data        Json
  createdAt   DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum TemplateType {
  BILLING
  RECEIPT
  NOTICE
  OTHER
}

model TemplateGroup {
  id        String       @id @default(cuid())
  name      String
  type      TemplateType
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  templates Template[]
}

model Template {
  id          String        @id @default(cuid())
  groupId     String
  group       TemplateGroup @relation(fields: [groupId], references: [id])
  version     Int
  isDraft     Boolean       @default(true)
  isPublished Boolean       @default(false)
  contentJson Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([groupId, version])
}

model MessageDeliveryLog {
  id           String    @id @default(uuid())
  referenceId  String    @unique @db.Text
  lineUserId   String    @db.Text
  status       String    @db.Text
  retryCount   Int       @default(0)
  errorMessage String?   @db.Text
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@map("message_delivery_log")
}

model BillingAuditLog {
  id         String   @id @default(uuid())
  billId     String   @db.Text
  action     String   @db.Text
  beforeData Json
  afterData  Json
  createdAt  DateTime @default(now())

  @@map("billing_audit_log")
}

model RegistrationRequest {
  id           String              @id @default(cuid())
  lineUserId   String
  roomNumber   String
  residentName String?
  phone        String?
  status       RegistrationStatus  @default(PENDING)
  reason       String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([lineUserId])
  @@index([roomNumber])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model LineConversationState {
  id         String   @id @default(cuid())
  lineUserId String   @unique
  state      String
  tempRoom   String?
  tempName   String?
  tempPhone  String?
  updatedAt  DateTime @updatedAt
}
